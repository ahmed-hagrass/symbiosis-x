{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "python3 -m pip install --quiet --target .build-deps fastapi==0.128.8",
  "buildCommand": "PYTHONPATH=.build-deps:backend/src python3 scripts/build_site.py public",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/src/**,catalogs/**,scenarios/**,contracts/**}"
    }
  },
  "redirects": [{ "source": "/", "destination": "/flight", "permanent": false }],
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/index" },
    { "source": "/health/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    { "source": "/(flight|mission)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
